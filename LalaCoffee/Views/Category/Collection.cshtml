@model IEnumerable<LalaCoffee.Models.Product>
@{
    Page.Title = "Index";
    Layout = "~/Views/Shared/_Layout_User.cshtml";
}

<main>
    <div class="main-part">

        <section class="breadcrumb-nav">
            <div class="container">
                <div class="breadcrumb-nav-inner" style="text-align:center">
                    <label class="now">MENU</label>
                </div>
            </div>
        </section>

        <section class="default-section shop-page">
            <div class="container">
                <div class="row">
                    <div class="col-md-3 col-sm-4 col-12">
                        <div class="blog-left-section">
                            <form method="get" action="/Collections/@(string.IsNullOrEmpty(ViewBag.CurrentSlug) ? "All" : ViewBag.CurrentSlug)" class="blog-left-search blog-common-wide wow fadeInDown animated" data-wow-duration="1000ms" data-wow-delay="300ms" style="visibility: visible; animation-duration: 1000ms; animation-delay: 300ms; animation-name: fadeInDown;">
                                <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm kiếm món...">
                                <input type="submit" value="&#xf002;" aria-label="Tìm kiếm" title="Tìm kiếm">
                            </form>
                            <div class="blog-left-categories blog-common-wide wow fadeInDown animated" data-wow-duration="1000ms" data-wow-delay="300ms" style="visibility: visible; animation-duration: 1000ms; animation-delay: 300ms; animation-name: fadeInDown;">
                                <h5>
                                    DANH MỤC
                                </h5>
                                <ul class="list">
                                    @foreach (var Category in ViewBag.ListCate)
                                    {
                                        var isCurrentCategory = string.Equals((string)Category.Slug, (string)ViewBag.CurrentSlug, StringComparison.OrdinalIgnoreCase);
                                        <li><a href="/Collections/@Category.Slug" style="@(isCurrentCategory ? "font-weight: 700;" : null)" aria-current="@(isCurrentCategory ? "page" : null)">@Category.Name</a></li>
                                    }
                                </ul>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-9 col-sm-8 col-12">
                        @foreach (var Category in ViewBag.Categories)
                        {
                            <div class="blog-right-section">
                                <h3 class="block_menu_item_title">
                                    <span class="line_after_heading section_heading" style="color: #c19942">@Category.Name</span>
                                </h3>
                                <div class="row">
                                    @foreach (var item in Model)
                                    {
                                        if (item.Category != null && item.Category.Id == Category.Id)
                                        {
                                            <div class="col-md-4 col-sm-4 col-12 wow fadeInDown animated" data-wow-duration="1000ms" data-wow-delay="300ms" style="visibility: visible; animation-duration: 1000ms; animation-delay: 300ms; animation-name: fadeInDown;">
                                                <div class="shop-main-list">
                                                    <div class="shop-product">
                                                        <a href="~/Product/@item.Slug"> <img src="@item.Image" alt="productImage"></a>

                                                    </div>
                                                    <a href="~/Product/@item.Slug"><h5>@item.Name</h5></a>
                                                    <h5><strong>@item.Price.ToString("N0")d</strong></h5>
                                                </div>
                                            </div>
                                        }

                                    }

                                </div>
                            </div>}
                    </div>

                </div>
            </div>
    </div>
    </div>
    </section>

    </div>
</main>
