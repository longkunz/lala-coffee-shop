@model LalaCoffee.Data.ApplicationUser

@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout_User.cshtml";
    var fieldErrors = ViewBag.FieldErrors as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
}

<section class="account-auth-section">
    <div class="auth-box">
        <div class="auth-content">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="auth-form-body">
                    <h2>ĐĂNG KÝ</h2>
                    @if (ViewBag.GeneralErrors != null && ((List<string>)ViewBag.GeneralErrors).Count > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <button type="button" class="close" data-dismiss="alert" data-bs-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                            <strong><i class="fa fa-exclamation-circle mr-1"></i> Có lỗi xảy ra:</strong>
                            <ul class="mb-0 mt-1 pl-3">
                                @foreach (var err in (List<string>)ViewBag.GeneralErrors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="input-wrap">
                        <div class="inputbox @(fieldErrors.ContainsKey("UserName") ? "has-error" : "")">
                            <ion-icon name="person-outline"></ion-icon>
                            <input type="text" placeholder="Tên đăng nhập" name="UserName" id="UserName" value="@(ViewBag.UserName ?? Request["UserName"])">
                        </div>
                        @if (fieldErrors.ContainsKey("UserName"))
                        {
                            <span class="error-msg">@fieldErrors["UserName"]</span>
                        }
                    </div>

                    <div class="input-wrap">
                        <div class="inputbox has-toggle @(fieldErrors.ContainsKey("PasswordHash") ? "has-error" : "")">
                            <ion-icon name="lock-closed-outline" aria-hidden="true"></ion-icon>
                            <input type="password" placeholder="Mật khẩu" name="PasswordHash" id="PasswordHash">
                            <button type="button" class="btn-toggle-password" id="togglePasswordBtn" tabindex="-1" title="Hiện mật khẩu" aria-label="Hiện mật khẩu">
                                <i class="fa fa-eye-slash" id="togglePasswordIcon" aria-hidden="true"></i>
                            </button>
                        </div>
                        @if (fieldErrors.ContainsKey("PasswordHash"))
                        {
                            <span class="error-msg">@fieldErrors["PasswordHash"]</span>
                        }
                    </div>

                    <div class="input-wrap">
                        <div class="inputbox @(fieldErrors.ContainsKey("Email") ? "has-error" : "")">
                            <ion-icon name="mail-outline"></ion-icon>
                            <input type="email" placeholder="Địa chỉ Email" name="Email" id="Email" value="@(ViewBag.Email ?? Request["Email"])">
                        </div>
                        @if (fieldErrors.ContainsKey("Email"))
                        {
                            <span class="error-msg">@fieldErrors["Email"]</span>
                        }
                    </div>

                    <div class="input-wrap">
                        <div class="inputbox @(fieldErrors.ContainsKey("PhoneNumber") ? "has-error" : "")">
                            <ion-icon name="call-outline"></ion-icon>
                            <input type="text" placeholder="Số điện thoại" name="PhoneNumber" id="PhoneNumber" value="@(ViewBag.PhoneNumber ?? Request["PhoneNumber"])">
                        </div>
                        @if (fieldErrors.ContainsKey("PhoneNumber"))
                        {
                            <span class="error-msg">@fieldErrors["PhoneNumber"]</span>
                        }
                    </div>

                    <button class="btn-auth-submit" type="submit">
                        <i class="fa fa-user-plus mr-2" aria-hidden="true"></i>Đăng Ký
                    </button>
                </div>
            }
            <div class="auth-switch-link">
                <p>Bạn đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập ngay</a></p>
            </div>
        </div>
    </div>
</section>

<style>
    .account-auth-section {
        min-height: calc(100vh - 140px);
        padding: 60px 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        background-color: #f7f5f2;
        box-sizing: border-box;
    }

    .account-auth-section .auth-box {
        position: relative;
        width: 440px;
        max-width: 100%;
        border: 2px solid #2b1e16;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
        backdrop-filter: blur(15px);
        padding: 40px 35px 35px;
        box-sizing: border-box;
        margin: auto;
    }

    .account-auth-section h2 {
        font-size: 1.85em;
        font-weight: 700;
        color: #2b1e16;
        text-align: center;
        margin: 0 0 25px 0;
        letter-spacing: 1px;
    }

    .account-auth-section .input-wrap {
        width: 100%;
        margin-bottom: 20px;
    }

    .account-auth-section .inputbox {
        position: relative;
        width: 100%;
        border-bottom: 2px solid #2b1e16;
        transition: border-color 0.25s ease;
    }

    .account-auth-section .inputbox.has-error {
        border-bottom: 2px solid #dc3545 !important;
    }

    .account-auth-section .inputbox input {
        width: 100%;
        height: 48px;
        background: transparent;
        border: none;
        outline: none;
        font-size: 0.95em;
        padding: 0 35px 0 5px;
        color: #2b1e16;
        box-shadow: none !important;
    }

    .account-auth-section .inputbox.has-toggle input {
        padding-right: 68px;
    }

    .account-auth-section .inputbox ion-icon {
        position: absolute;
        right: 8px;
        color: #2b1e16;
        font-size: 1.25em;
        top: 13px;
        transition: color 0.25s ease;
        pointer-events: none;
    }

    .account-auth-section .inputbox.has-toggle ion-icon {
        right: 36px;
    }

    .account-auth-section .inputbox.has-error ion-icon {
        color: #dc3545 !important;
    }

    .account-auth-section .btn-toggle-password {
        position: absolute;
        right: 6px;
        top: 11px;
        background: transparent;
        border: none;
        outline: none;
        cursor: pointer;
        color: #666;
        font-size: 1.15em;
        padding: 4px;
        transition: color 0.2s ease, transform 0.15s ease;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .account-auth-section .btn-toggle-password:hover {
        color: #2b1e16;
        transform: scale(1.1);
    }

    .account-auth-section .inputbox.has-error .btn-toggle-password {
        color: #dc3545;
    }

    .account-auth-section .error-msg {
        display: block;
        margin-top: 6px;
        margin-bottom: 2px;
        color: #dc3545 !important;
        font-size: 0.82rem;
        font-weight: 600;
        line-height: 1.35;
        text-align: left;
    }

    .account-auth-section .btn-auth-submit {
        width: 100%;
        height: 46px;
        border-radius: 40px;
        background: #2b1e16;
        color: #ffffff !important;
        border: none;
        outline: none;
        cursor: pointer;
        font-size: 1.02em;
        font-weight: 600;
        margin-top: 15px;
        margin-bottom: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        transition: background-color 0.25s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }

    .account-auth-section .btn-auth-submit:hover {
        background: #4a3425;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(43, 30, 22, 0.25);
    }

    .account-auth-section .auth-switch-link {
        font-size: 0.9em;
        color: #2b1e16;
        text-align: center;
        margin-top: 20px;
    }

    .account-auth-section .auth-switch-link p {
        margin: 0;
    }

    .account-auth-section .auth-switch-link a {
        text-decoration: none;
        color: #c59d5f;
        font-weight: 700;
        margin-left: 4px;
    }

    .account-auth-section .auth-switch-link a:hover {
        text-decoration: underline;
        color: #a87e3f;
    }
</style>
<script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        var toggleBtn = document.getElementById("togglePasswordBtn");
        var passwordInput = document.getElementById("PasswordHash");
        var toggleIcon = document.getElementById("togglePasswordIcon");
        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener("click", function (e) {
                e.preventDefault();
                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    toggleIcon.classList.remove("fa-eye-slash");
                    toggleIcon.classList.add("fa-eye");
                    toggleBtn.setAttribute("title", "Ẩn mật khẩu");
                    toggleBtn.setAttribute("aria-label", "Ẩn mật khẩu");
                } else {
                    passwordInput.type = "password";
                    toggleIcon.classList.remove("fa-eye");
                    toggleIcon.classList.add("fa-eye-slash");
                    toggleBtn.setAttribute("title", "Hiện mật khẩu");
                    toggleBtn.setAttribute("aria-label", "Hiện mật khẩu");
                }
            });
        }
    });
</script>