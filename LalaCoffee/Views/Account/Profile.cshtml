@model LalaCoffee.Models.UserProfileViewModel
@{
    Page.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout_User.cshtml";
    var profileErrors = ViewBag.ProfileFieldErrors as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var passwordErrors = ViewBag.PasswordErrors as List<string> ?? new List<string>();
    var successProfile = TempData["SuccessMessage"] as string;
    var successPassword = TempData["SuccessPasswordMessage"] as string;
}

<main>
    <div class="main-part">
        <section class="default-section profile-section bg-grey py-5">
            <div class="container">
                <div class="profile-header mb-4">
                    <h2 class="title text-uppercase font-weight-bold" style="color: #2b2b2b;">Tài khoản của tôi</h2>
                    <p class="text-muted">Quản lý thông tin hồ sơ, địa chỉ nhận hàng và bảo mật tài khoản.</p>
                </div>

                @if (!string.IsNullOrEmpty(successProfile))
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="fa fa-check-circle mr-2"></i> @successProfile
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successPassword))
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="fa fa-check-circle mr-2"></i> @successPassword
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="row">
                    <!-- Left: Thông tin nhận hàng (Checkout Fields) -->
                    <div class="col-lg-7 col-md-12 mb-4">
                        <div class="card shadow-sm border-0 rounded-3 h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="profile-icon-wrap me-3" style="width: 42px; height: 42px; background: #fff3e6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #b78a58; font-size: 20px;">
                                        <i class="fa fa-user"></i>
                                    </div>
                                    <div>
                                        <h4 class="mb-0 fw-bold" style="font-size: 20px;">THÔNG TIN NHẬN HÀNG &amp; CÁ NHÂN</h4>
                                        <small class="text-muted">Thông tin này sẽ tự động điền sẵn khi bạn thanh toán đơn hàng</small>
                                    </div>
                                </div>
                                <hr />

                                @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Tên đăng nhập</label>
                                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control bg-light", @readonly = "readonly", style = "cursor: not-allowed;" })
                                        <small class="text-muted fst-italic">Tên đăng nhập không thể thay đổi.</small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control " + (profileErrors.ContainsKey("FullName") ? "is-invalid" : ""), placeholder = "Ví dụ: Nguyễn Văn A" })
                                        @if (profileErrors.ContainsKey("FullName"))
                                        {
                                            <div class="invalid-feedback d-block">@profileErrors["FullName"]</div>
                                        }
                                        else
                                        {
                                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                                        }
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control " + (profileErrors.ContainsKey("PhoneNumber") ? "is-invalid" : ""), placeholder = "Ví dụ: 0901234567" })
                                            @if (profileErrors.ContainsKey("PhoneNumber"))
                                            {
                                                <div class="invalid-feedback d-block">@profileErrors["PhoneNumber"]</div>
                                            }
                                            else
                                            {
                                                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                                            }
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Địa chỉ Email <span class="text-danger">*</span></label>
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control " + (profileErrors.ContainsKey("Email") ? "is-invalid" : ""), placeholder = "email@example.com", type = "email" })
                                            @if (profileErrors.ContainsKey("Email"))
                                            {
                                                <div class="invalid-feedback d-block">@profileErrors["Email"]</div>
                                            }
                                            else
                                            {
                                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                            }
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Địa chỉ nhận hàng mặc định <span class="text-danger">*</span></label>
                                        @Html.TextAreaFor(m => m.Address, 3, 20, new { @class = "form-control " + (profileErrors.ContainsKey("Address") ? "is-invalid" : ""), placeholder = "Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." })
                                        @if (profileErrors.ContainsKey("Address"))
                                        {
                                            <div class="invalid-feedback d-block">@profileErrors["Address"]</div>
                                        }
                                        else
                                        {
                                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                                        }
                                    </div>

                                    <div class="text-end">
                                        <button type="submit" class="button-default btn-large btn-primary-gold px-4">
                                            <i class="fa fa-save me-1"></i> Lưu thay đổi
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right: Đổi mật khẩu -->
                    <div class="col-lg-5 col-md-12 mb-4">
                        <div class="card shadow-sm border-0 rounded-3 h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="profile-icon-wrap me-3" style="width: 42px; height: 42px; background: #fee8e8; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #dc3545; font-size: 20px;">
                                        <i class="fa fa-lock"></i>
                                    </div>
                                    <div>
                                        <h4 class="mb-0 fw-bold" style="font-size: 20px;">ĐỔI MẬT KHẨU</h4>
                                        <small class="text-muted">Cập nhật mật khẩu bảo mật tài khoản</small>
                                    </div>
                                </div>
                                <hr />

                                @if (passwordErrors != null && passwordErrors.Count > 0)
                                {
                                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                        <strong><i class="fa fa-exclamation-triangle mr-1"></i> Đổi mật khẩu thất bại:</strong>
                                        <ul class="mb-0 mt-1 ps-3">
                                            @foreach (var err in passwordErrors)
                                            {
                                                <li>@err</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                                        <div class="pw-field-wrap">
                                            <input type="password" name="CurrentPassword" id="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại" required />
                                            <button class="btn-toggle-pw" type="button" data-target="CurrentPassword" tabindex="-1" title="Hiện mật khẩu" aria-label="Hiện mật khẩu">
                                                <i class="fa fa-eye-slash"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Mật khẩu mới <span class="text-danger">*</span></label>
                                        <div class="pw-field-wrap">
                                            <input type="password" name="NewPassword" id="NewPassword" class="form-control" placeholder="Nhập mật khẩu mới" required />
                                            <button class="btn-toggle-pw" type="button" data-target="NewPassword" tabindex="-1" title="Hiện mật khẩu" aria-label="Hiện mật khẩu">
                                                <i class="fa fa-eye-slash"></i>
                                            </button>
                                        </div>
                                        <small class="text-muted fst-italic">Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số &amp; ký tự đặc biệt.</small>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                                        <div class="pw-field-wrap">
                                            <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="form-control" placeholder="Xác nhận lại mật khẩu mới" required />
                                            <button class="btn-toggle-pw" type="button" data-target="ConfirmPassword" tabindex="-1" title="Hiện mật khẩu" aria-label="Hiện mật khẩu">
                                                <i class="fa fa-eye-slash"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="text-end">
                                        <button type="submit" class="button-default btn-large btn-primary-gold px-4">
                                            <i class="fa fa-key me-1"></i> Cập nhật mật khẩu
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<style>
    .profile-section .form-control {
        height: 48px !important;
        border-radius: 8px !important;
        border: 1px solid #ced4da !important;
        font-size: 14px;
        box-shadow: none;
    }
    .profile-section textarea.form-control {
        height: auto !important;
    }
    .profile-section .form-control:focus {
        border-color: #b78a58 !important;
        box-shadow: 0 0 0 0.2rem rgba(183, 138, 88, 0.2) !important;
    }
    .profile-section .pw-field-wrap {
        position: relative !important;
        width: 100% !important;
        display: block !important;
    }
    .profile-section .pw-field-wrap input.form-control {
        width: 100% !important;
        padding-right: 48px !important;
        box-sizing: border-box !important;
    }
    .profile-section .pw-field-wrap .btn-toggle-pw {
        position: absolute !important;
        right: 12px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        background: transparent !important;
        border: none !important;
        outline: none !important;
        padding: 6px 8px !important;
        margin: 0 !important;
        cursor: pointer !important;
        color: #777 !important;
        font-size: 16px !important;
        line-height: 1 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        z-index: 10 !important;
        transition: color 0.2s ease !important;
    }
    .profile-section .pw-field-wrap .btn-toggle-pw:hover {
        color: #b78a58 !important;
    }
</style>

<script type="text/javascript">
    $(document).ready(function () {
        $('.btn-toggle-pw').on('click', function (e) {
            e.preventDefault();
            var targetId = $(this).data('target');
            var $input = $('#' + targetId);
            var $icon = $(this).find('i');
            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                $(this).attr('title', 'Ẩn mật khẩu').attr('aria-label', 'Ẩn mật khẩu');
            } else {
                $input.attr('type', 'password');
                $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                $(this).attr('title', 'Hiện mật khẩu').attr('aria-label', 'Hiện mật khẩu');
            }
        });
    });
</script>
