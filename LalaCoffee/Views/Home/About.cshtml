@{
    ViewBag.Title = "Về Chúng Tôi - LalaCoffee";
    Layout = "~/Views/Shared/_Layout_User.cshtml";
}

<main>
    <div class="main-part">

        <section class="breadcrumb-nav">
            <div class="container text-center">
                <div class="breadcrumb-nav-inner">
                    <label class="now">VỀ CHÚNG TÔI</label>
                </div>
            </div>
        </section>

        <section class="default-section pad-top-remove" style="padding-bottom: 50px;">
            <div class="container">
                <div class="title text-center" style="margin-bottom: 40px;">
                    <h2 class="text-coffee" style="color: #8b572a; font-size: 32px; font-weight: 700; text-transform: uppercase;">
                        Câu Chuyện LalaCoffee
                    </h2>
                    <h6 style="font-size: 17px; color: #7d6b5e; max-width: 750px; margin: 12px auto 0; line-height: 1.6;">
                        Tình yêu với những giọt cà phê mộc đậm đà nguyên bản và khát khao mang đến một điểm hẹn thư thái cho người Việt.
                    </h6>
                </div>

                <div class="row align-items-center" style="display: flex; flex-wrap: wrap; margin-bottom: 50px;">
                    <div class="col-md-6 col-sm-12" style="margin-bottom: 25px;">
                        <div style="background: #faf6f0; border-left: 4px solid #c19942; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
                            <h4 style="color: #4a2c11; font-weight: 700; margin-bottom: 15px;">Khởi Nguồn Từ Đam Mê</h4>
                            <p style="font-size: 15px; line-height: 1.8; color: #555; margin-bottom: 15px;">
                                <strong>LalaCoffee</strong> được thành lập từ niềm đam mê sâu sắc với văn hóa cà phê Việt Nam. Chúng tôi tin rằng một ly cà phê ngon không đơn thuần là thức uống tỉnh táo mỗi sớm mai, mà còn là khởi đầu của những ý tưởng mới, những cuộc trò chuyện chân thành và những khoảnh khắc gắn kết đáng nhớ.
                            </p>
                            <p style="font-size: 15px; line-height: 1.8; color: #555; margin-bottom: 0;">
                                Đặt trọn tâm huyết vào từng công đoạn — từ việc chọn lựa những nông trại canh tác hữu cơ tại Đắk Lắk, Lâm Đồng cho đến quy trình rang mộc chuẩn nhiệt độ — LalaCoffee cam kết mang đến hương vị cà phê sạch, thơm nồng tự nhiên và hậu vị ngọt thanh lắng đọng.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12" style="margin-bottom: 25px;">
                        <div style="background: #faf6f0; border-left: 4px solid #a07830; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
                            <h4 style="color: #4a2c11; font-weight: 700; margin-bottom: 15px;">Không Gian Của Sự Kết Nối</h4>
                            <p style="font-size: 15px; line-height: 1.8; color: #555; margin-bottom: 15px;">
                                Tại LalaCoffee, mỗi góc quán đều được thiết kế mang hơi thở mộc mạc của gỗ và hương thơm thoang thoảng của cà phê mới xay. Dù bạn cần một góc yên tĩnh để tập trung làm việc, một không gian thoáng đãng để đọc sách hay một bàn tiệc rộn rã cùng nhóm bạn, LalaCoffee luôn sẵn sàng chào đón bạn.
                            </p>
                            <p style="font-size: 15px; line-height: 1.8; color: #555; margin-bottom: 0;">
                                Với đội ngũ barista tận tâm và hệ thống đặt hàng trực tuyến tiện lợi, chúng tôi nỗ lực từng ngày để trao gửi những tách cà phê hảo hạng đến tận tay bạn trọn vẹn và nhanh chóng nhất.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="title text-center" style="margin-bottom: 35px;">
                    <h3 style="color: #4a2c11; font-size: 24px; font-weight: 700;">3 Giá Trị Cốt Lõi Tại LalaCoffee</h3>
                </div>

                <div class="row text-center">
                    <div class="col-md-4 col-sm-6" style="margin-bottom: 25px;">
                        <div style="border: 1px solid #eadbc8; border-radius: 10px; padding: 30px 20px; height: 100%; background: #fff; transition: all 0.3s ease;">
                            <div style="width: 60px; height: 60px; line-height: 60px; border-radius: 50%; background: #c19942; color: #fff; margin: 0 auto 18px; font-size: 24px;">
                                <i class="fa fa-coffee"></i>
                            </div>
                            <h5 style="color: #4a2c11; font-weight: 700; margin-bottom: 12px;">100% Cà Phê Mộc</h5>
                            <p style="color: #666; font-size: 14px; line-height: 1.6; margin: 0;">
                                Tuyển chọn hạt Robusta & Arabica thượng hạng, rang mộc hoàn toàn không tẩm bơ, không hương liệu hay chất tạo màu hóa học.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6" style="margin-bottom: 25px;">
                        <div style="border: 1px solid #eadbc8; border-radius: 10px; padding: 30px 20px; height: 100%; background: #fff; transition: all 0.3s ease;">
                            <div style="width: 60px; height: 60px; line-height: 60px; border-radius: 50%; background: #c19942; color: #fff; margin: 0 auto 18px; font-size: 24px;">
                                <i class="fa fa-heart"></i>
                            </div>
                            <h5 style="color: #4a2c11; font-weight: 700; margin-bottom: 12px;">Pha Chế Tận Tâm</h5>
                            <p style="color: #666; font-size: 14px; line-height: 1.6; margin: 0;">
                                Mỗi thức uống là sự kết hợp khéo léo giữa kỹ thuật chiết xuất hiện đại và tình yêu nghề của đội ngũ Barista tại Lala.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-12" style="margin-bottom: 25px;">
                        <div style="border: 1px solid #eadbc8; border-radius: 10px; padding: 30px 20px; height: 100%; background: #fff; transition: all 0.3s ease;">
                            <div style="width: 60px; height: 60px; line-height: 60px; border-radius: 50%; background: #c19942; color: #fff; margin: 0 auto 18px; font-size: 24px;">
                                <i class="fa fa-users"></i>
                            </div>
                            <h5 style="color: #4a2c11; font-weight: 700; margin-bottom: 12px;">Thân Thiện & Bền Vững</h5>
                            <p style="color: #666; font-size: 14px; line-height: 1.6; margin: 0;">
                                Luôn ưu tiên bao bì thân thiện môi trường, đồng hành cùng người nông dân vùng cao và gắn kết cộng đồng yêu cà phê.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="text-center" style="margin-top: 30px; background: #1d1414; color: #fff; padding: 40px 20px; border-radius: 12px;">
                    <h3 style="color: #e4b95b; font-size: 24px; font-weight: 700; margin-bottom: 10px;">Ghé Thăm LalaCoffee</h3>
                    <p style="font-size: 15px; color: #d0c2b2; margin-bottom: 8px;">
                        <i class="fa fa-map-marker text-warning"></i> 783 Võ Văn Kiệt, Phường Chợ Quán, TPHCM
                    </p>
                    <p style="font-size: 15px; color: #d0c2b2; margin-bottom: 25px;">
                        <i class="fa fa-phone text-warning"></i> Hotline: <a href="tel:0888888888" style="color: #fff; font-weight: 600;">08 8888 8888</a> |
                        <i class="fa fa-envelope text-warning ml-2"></i> <a href="mailto:admin@lalacoffee.vn" style="color: #fff;">admin@lalacoffee.vn</a>
                    </p>
                    <div>
                        <a href="/Collections/All" class="btn" style="background: #c19942; color: #fff; font-weight: 700; padding: 12px 28px; border-radius: 25px; margin: 5px; text-transform: uppercase;">
                            Khám Phá Thực Đơn
                        </a>
                        <a href="@Url.Action("Contact", "Home")" class="btn" style="background: transparent; border: 2px solid #c19942; color: #c19942; font-weight: 700; padding: 10px 26px; border-radius: 25px; margin: 5px; text-transform: uppercase;">
                            Gửi Lời Nhắn
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </div>
</main>
