@model LalaCoffee.Models.ContactViewModel
@{
    ViewBag.Title = "Liên Hệ - LalaCoffee";
    Layout = "~/Views/Shared/_Layout_User.cshtml";
    var successMsg = TempData["SuccessMessage"] as string;
}

<main>
    <div class="main-part">
        <!-- Breadcrumb -->
        <section class="breadcrumb-nav">
            <div class="container text-center">
                <div class="breadcrumb-nav-inner">
                    <label class="now">LIÊN HỆ VỚI CHÚNG TÔI</label>
                </div>
            </div>
        </section>

        <section class="default-section contact-part pad-top-remove py-5">
            <div class="container">
                <div class="title text-center mb-5">
                    <h2 class="text-coffee" style="color: #8b572a; font-weight: 700; text-transform: uppercase;">Liên Hệ</h2>
                    <h6 class="text-muted" style="max-width: 600px; margin: 0 auto; line-height: 1.6;">
                        LalaCoffee luôn sẵn sàng lắng nghe mọi góp ý, câu hỏi và đề xuất hợp tác từ bạn.
                    </h6>
                </div>

                @if (!string.IsNullOrEmpty(successMsg))
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
                        <i class="fa fa-check-circle me-2"></i> @successMsg
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="row g-4 align-items-stretch">
                    <!-- Form gửi tin nhắn -->
                    <div class="col-lg-5 col-md-6 col-12">
                        <div class="card border-0 shadow-sm rounded-3 p-4 h-100 bg-white">
                            <h4 class="mb-3 fw-bold" style="color: #2b1e16; font-size: 20px;">Để lại tin nhắn cho LalaCoffee</h4>
                            <p class="text-muted small mb-4">Điền thông tin bên dưới, nhân viên hỗ trợ của chúng tôi sẽ liên hệ lại với bạn.</p>

                            @using (Html.BeginForm("Contact", "Home", FormMethod.Post, new { @class = "contact-feedback-form" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                                <div class="mb-3">
                                    <label for="FullName" class="form-label fw-semibold" style="font-size: 14px; color: #3a3530;">Họ và tên <span class="text-danger">*</span></label>
                                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", id = "FullName", placeholder = "Ví dụ: Nguyễn Văn A", required = "required" })
                                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                                </div>

                                <div class="mb-3">
                                    <label for="Email" class="form-label fw-semibold" style="font-size: 14px; color: #3a3530;">Địa chỉ Email <span class="text-danger">*</span></label>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "Email", type = "email", placeholder = "email@example.com", required = "required" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                                </div>

                                <div class="mb-3">
                                    <label for="PhoneNumber" class="form-label fw-semibold" style="font-size: 14px; color: #3a3530;">Số điện thoại</label>
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", id = "PhoneNumber", placeholder = "0901 234 567" })
                                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                                </div>

                                <div class="mb-4">
                                    <label for="Message" class="form-label fw-semibold" style="font-size: 14px; color: #3a3530;">Lời nhắn của bạn <span class="text-danger">*</span></label>
                                    @Html.TextAreaFor(m => m.Message, 5, 20, new { @class = "form-control", id = "Message", placeholder = "Nội dung cần trao đổi hoặc hỗ trợ...", required = "required" })
                                    @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger small" })
                                </div>

                                <button type="submit" class="btn w-100 py-2 fw-bold text-white shadow-sm" style="background: #8b572a; border-radius: 6px; letter-spacing: 0.5px;">
                                    <i class="fa fa-paper-plane me-2"></i> GỬI TIN NHẮN
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Bản đồ & Thông tin trực tiếp -->
                    <div class="col-lg-7 col-md-6 col-12">
                        <div class="card border-0 shadow-sm rounded-3 overflow-hidden h-100 bg-white">
                            <div class="p-4 border-bottom bg-light">
                                <h5 class="fw-bold mb-2" style="color: #2b1e16;">☕ Quán LalaCoffee — Chi nhánh chính</h5>
                                <div class="small text-muted mb-1"><i class="fa fa-map-marker text-danger me-2"></i> 783 Võ Văn Kiệt, Phường Chợ Quán, TPHCM</div>
                                <div class="small text-muted mb-1"><i class="fa fa-clock-o text-warning me-2"></i> 07:00 – 22:30 (Mở cửa tất cả các ngày trong tuần)</div>
                                <div class="small text-muted"><i class="fa fa-phone text-success me-2"></i> Hotline: <a href="tel:0888888888" class="text-decoration-none fw-bold" style="color: #8b572a;">08 8888 8888</a></div>
                            </div>
                            <div style="flex: 1; min-height: 400px;">
                                <iframe src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d692.666522859533!2d106.80542313721728!3d10.863738203048896!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMTDCsDUxJzQ4LjkiTiAxMDbCsDQ4JzIwLjQiRQ!5e0!3m2!1svi!2s!4v1680446972833!5m2!1svi!2s" 
                                        style="border:0; width: 100%; height: 100%; min-height: 400px;" 
                                        allowfullscreen="" 
                                        loading="lazy" 
                                        referrerpolicy="no-referrer-when-downgrade"
                                        title="Vị trí LalaCoffee trên Google Maps"></iframe>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>
