@model LalaCoffee.Models.Product
@*@using IEnumerable<LalaCoffee.Models.Category>*@

@{
    Page.Title = Model.Name;
    Layout = "~/Views/Shared/_Layout_User.cshtml";
}
<script type="text/javascript">
    function changeQuantity(change) {
        var $input = $('#quantity');
        var current = parseInt($input.val(), 10);
        if (isNaN(current) || current < 1) {
            current = 1;
        }
        var next = Math.max(1, current + change);
        $input.val(next);
    }

    function plusQuantity() {
        changeQuantity(1);
    }

    function minusQuantity() {
        changeQuantity(-1);
    }

    $(document).ready(function () {
        if ($('input[name="propertyId"]:checked').length === 0 && $('input[name="propertyId"]').length > 0) {
            $('input[name="propertyId"]').eq(0).prop('checked', true);
        }

        $('#quantity').on('change blur', function () {
            var val = parseInt($(this).val(), 10);
            if (isNaN(val) || val < 1) {
                $(this).val(1);
            } else {
                $(this).val(val);
            }
        });

        $('#addToCart').click(function (e) {
            e.preventDefault();
            var productId = $('#productId').val();
            var propertyId = $('input[name="propertyId"]:checked').val() || 0;

            var rawQuantity = parseInt($('#quantity').val(), 10);
            var quantity = (isNaN(rawQuantity) || rawQuantity < 1) ? 1 : rawQuantity;
            $('#quantity').val(quantity);

            var optionProductIds = [];
            $('input[name^="optionProducts"]:checked, .form-check-input:checked').each(function () {
                var optVal = parseInt($(this).val(), 10);
                if (!isNaN(optVal)) {
                    optionProductIds.push(optVal);
                }
            });

            var $btn = $(this);
            $btn.addClass('disabled').css('pointer-events', 'none');

            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: {
                    productId: productId,
                    quantity: quantity,
                    optionProductIds: optionProductIds,
                    propertyId: propertyId
                },
                success: function (data) {
                    $btn.removeClass('disabled').css('pointer-events', 'auto');
                    if (data && data.status == true) {
                        if (typeof getTotalCart === 'function') {
                            getTotalCart();
                        }
                        Swal.fire('Thêm thành công!', data.message, 'success');
                    } else {
                        Swal.fire('Thông báo', (data && data.message) ? data.message : 'Có lỗi xảy ra khi thêm vào giỏ hàng!', 'warning');
                    }
                },
                error: function () {
                    $btn.removeClass('disabled').css('pointer-events', 'auto');
                    Swal.fire('Có lỗi xảy ra!', 'Không thể thêm vào giỏ hàng. Vui lòng thử lại!', 'error');
                }
            });
        });
    });
</script>
<main>
    <div class="main-part">
        <section class="default-section shop-single pad-bottom-remove">
            <div class="container">
                <div class="row">
                    <div class="col-md-6 col-sm-6 col-xs-12 wow fadeInDown" data-wow-duration="1000ms" data-wow-delay="300ms">
                        <div class="slider slider-for slick-shop">
                            <div>
                                <img src="@Model.Image" alt="@Model.Name">
                            </div>
                        </div>
                        @*<div class="slider slider-nav slick-shop-thumb">
                            <div><img src="@Model.Image" alt="@Model.Name"></div>
                        </div>*@
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12 wow fadeInDown" data-wow-duration="1000ms" data-wow-delay="300ms">
                        <input type="hidden" id="productId" value="@Model.Id" />
                        <h4 class="text-coffee">@Model.Name</h4>
                        <h3 class="text-coffee">@Model.Price.ToString("N0")đ</h3>
                        @{
                            var propertyProducts = ViewBag.PropertyProducts as IEnumerable<LalaCoffee.Models.PropertyProduct>;
                            var optionProducts = ViewBag.OptionProducts as IEnumerable<LalaCoffee.Models.OptionProduct>;
                            var hasProperties = propertyProducts != null && propertyProducts.Any();
                            var hasOptions = optionProducts != null && optionProducts.Any();
                        }
                        @if (hasProperties || hasOptions)
                        {
                            <div class="share-tag">
                                <div class="row">
                                    @if (hasProperties)
                                    {
                                        <div class="col-md-12 col-sm-12 col-xs-12">
                                            <div class="tag-wrap">
                                                <p><h5>Size</h5></p>
                                                @{ var isFirstProperty = true; }
                                                @foreach (var propertyProduct in propertyProducts)
                                                {
                                                    <input type="radio" id="propertyId_@propertyProduct.Id" name="propertyId" value="@propertyProduct.Id" @(isFirstProperty ? "checked" : "")>
                                                    <label for="propertyId_@propertyProduct.Id">@propertyProduct.Name - @propertyProduct.Price.ToString("N0")đ</label><br>
                                                    isFirstProperty = false;
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (hasOptions)
                                    {
                                        <div class="col-md-12 col-sm-12 col-xs-12">
                                            <div class="tag-wrap">
                                                <p><h5>Topping</h5></p>
                                                @foreach (var optionProduct in optionProducts)
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="optionProducts[@optionProduct.Id]" id="optionProduct_@optionProduct.Id" value="@optionProduct.Id">
                                                        <label class="form-check-label" for="optionProduct_@optionProduct.Id">
                                                            @optionProduct.Name - @optionProduct.Price.ToString("N0")đ
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="price-textbox">
                            <span class="minus-text" onclick="minusQuantity()" role="button" aria-label="Giảm số lượng"><i class="fa fa-minus"></i></span>
                            <input type="text" id="quantity" name="quantity" value="1" pattern="[0-9]*" inputmode="numeric" aria-label="Số lượng">
                            <span class="plus-text" onclick="plusQuantity()" role="button" aria-label="Tăng số lượng"><i class="fa fa-plus"></i></span>
                        </div>
                        <a href="#" class="filter-btn btn-large" id="addToCart"><i class="fa fa-shopping-bag" aria-hidden="true"></i> Thêm vào giỏ hàng</a>
                        @*<div class="share-tag">
            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="tag-wrap">
                        <h5>Danh mục</h5>
                        <a href="#" class="tag-btn">@Model.Category</a>
                    </div>
                </div>
            </div>
        </div>*@
                    </div>
                </div>
            </div>
        </section>

        <section class="default-section comment-review-tab bg-grey v-pad-remove wow fadeInDown animated" data-wow-duration="1000ms" data-wow-delay="300ms" style="visibility: visible; animation-duration: 1000ms; animation-delay: 300ms; animation-name: fadeInDown;">
            <div class="container">
                <div class="tab-part">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                        <a href="#description" aria-controls="description" role="tab" data-bs-toggle="tab" data-toggle="tab" aria-expanded="true">MÔ TẢ</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane active" id="description">
                            <p>
                                @Model.Description
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="default-section wow fadeInDown animated" data-wow-duration="1000ms" data-wow-delay="300ms" style="visibility: visible; animation-duration: 1000ms; animation-delay: 300ms; animation-name: fadeInDown;">
            <div class="container">
                <div class="title text-center">
                    <h3 class="text-coffee">Sản Phẩm Liên Quan</h3>
                </div>
                <div class="product-wrapper">
                    <div class="owl-carousel owl-theme" data-items="4" data-tablet="3" data-mobile="2" data-nav="false" data-dots="true" data-autoplay="true" data-speed="1800" data-autotime="5000">
                        @if (ViewBag.ProductRelative != null)
                        {
                            foreach (var item in (IEnumerable<LalaCoffee.Models.Product>)ViewBag.ProductRelative)
                            {
                                <div class="item">
                                    <div class="product-img">
                                        <a href="/Product/@item.Slug">
                                            <img src="@item.Image" alt="@item.Name">
                                            <span class="icon-basket fontello"></span>
                                        </a>
                                    </div>
                                    <h5><a href="/Product/@item.Slug">@item.Name</a></h5>
                                    <span>@item.Price.ToString("N0")đ</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>