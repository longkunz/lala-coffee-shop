@using Microsoft.AspNet.Identity
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title | LalaCoffee Admin Dashboard</title>
    <link rel="icon" type="image/png" href="~/Content/Layout/User/images/favicon.png">
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap">

    <!-- Icons -->
    <link rel="stylesheet" href="/Content/Layout/Admin/plugins/fontawesome-free/css/all.min.css">

    <!-- Bootstrap 5.3 & DataTables -->
    <link rel="stylesheet" href="/Content/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Content/Layout/Admin/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="/Content/Layout/Admin/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">

    <!-- LalaCoffee Admin Dashboard Theme -->
    <link rel="stylesheet" href="/Content/Layout/Admin/css/admin-dashboard.css">

    <script src="/Content/Layout/Admin/plugins/jquery/jquery.min.js"></script>
    <script src="/Content/Layout/Admin/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="/Content/Layout/Admin/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            var $table = $('#nTable');
            if ($table.length && !$table.data('server-side') && !$.fn.DataTable.isDataTable('#nTable')) {
                $table.DataTable({
                    "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Tất cả"]],
                    "language": {
                        "processing": "Đang tải dữ liệu...",
                        "lengthMenu": "Hiển thị _MENU_ mục",
                        "zeroRecords": "Không tìm thấy dữ liệu",
                        "info": "Hiển thị _START_ - _END_ của _TOTAL_ mục",
                        "infoEmpty": "Hiển thị 0 mục",
                        "infoFiltered": "(lọc từ _MAX_ mục)",
                        "search": "Tìm kiếm:",
                        "paginate": {
                            "first": "Đầu",
                            "previous": "Trước",
                            "next": "Tiếp",
                            "last": "Cuối"
                        }
                    }
                });
            }
        });
    </script>
</head>

<body class="admin-body">
    <div id="admin-wrapper">

        <!-- Responsive Sidebar (Offcanvas on Mobile, Fixed on Desktop) -->
        <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
            <div class="sidebar-header">
                <a href="/Admin/ManageOrder" class="sidebar-brand" id="adminSidebarLabel">
                    <img src="/Content/Layout/User/images/lalacoffee-logo-horizontal-dark.png" alt="LalaCoffee Admin" class="sidebar-logo-img" />
                </a>
                <button type="button" class="btn-close d-lg-none ms-auto" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Đóng menu"></button>
            </div>

            <div class="sidebar-content">
                <!-- User Quick Panel -->
                <div class="sidebar-user-panel">
                    <img src="/Content/Layout/Admin/images/avatar.png" class="sidebar-user-avatar" alt="Avatar">
                    <div class="sidebar-user-info user-info-text">
                        <a href="/Admin/ManageUser/ChangePassword" class="sidebar-user-name" title="Đổi mật khẩu">
                            @User.Identity.GetUserName()
                        </a>
                        <span class="sidebar-user-role">
                            <i class="fas fa-shield-alt me-1"></i>Quản trị viên
                        </span>
                    </div>
                </div>

                <!-- Navigation Menu -->
                <nav class="sidebar-nav">
                    <div class="nav-header">TỔNG QUAN</div>
                    <a href="/Admin/ManageOrder" class="nav-link-admin">
                        <i class="nav-icon fas fa-chart-line"></i>
                        <span>Bảng điều khiển</span>
                    </a>

                    <div class="nav-header">QUẢN LÝ CỬA HÀNG</div>
                    <a href="/Admin/ManageOrder" class="nav-link-admin">
                        <i class="nav-icon fas fa-shopping-bag"></i>
                        <span>Đơn hàng</span>
                    </a>

                    <!-- Sản phẩm Submenu -->
                    <a href="javascript:void(0)" class="nav-link-admin" data-bs-toggle="collapse" data-bs-target="#productSubmenu" role="button" aria-expanded="false" aria-controls="productSubmenu">
                        <i class="nav-icon fas fa-coffee"></i>
                        <span>Sản phẩm</span>
                        <i class="fas fa-chevron-right menu-arrow"></i>
                    </a>
                    <div class="collapse" id="productSubmenu">
                        <div class="nav-submenu">
                            <a href="/Admin/ManageProduct" class="nav-link-admin">
                                <i class="far fa-circle nav-icon" style="font-size:0.6rem;"></i>
                                <span>Tất cả sản phẩm</span>
                            </a>
                            <a href="/Admin/ManagePropertyProduct" class="nav-link-admin">
                                <i class="far fa-circle nav-icon" style="font-size:0.6rem;"></i>
                                <span>Kích cỡ (Size)</span>
                            </a>
                            <a href="/Admin/ManageOptionProduct" class="nav-link-admin">
                                <i class="far fa-circle nav-icon" style="font-size:0.6rem;"></i>
                                <span>Topping thêm</span>
                            </a>
                        </div>
                    </div>

                    <a href="/Admin/ManageCategory" class="nav-link-admin">
                        <i class="nav-icon fas fa-tags"></i>
                        <span>Danh mục món</span>
                    </a>

                    <a href="/Admin/ManageBlog" class="nav-link-admin">
                        <i class="nav-icon fas fa-newspaper"></i>
                        <span>Tin tức & Blog</span>
                    </a>

                    <div class="nav-header">TÀI KHOẢN & PHÂN QUYỀN</div>
                    <a href="/Admin/ManageUser" class="nav-link-admin">
                        <i class="nav-icon fas fa-users-cog"></i>
                        <span>Người dùng</span>
                    </a>

                    <!-- Quyền hạn Submenu -->
                    <a href="javascript:void(0)" class="nav-link-admin" data-bs-toggle="collapse" data-bs-target="#roleSubmenu" role="button" aria-expanded="false" aria-controls="roleSubmenu">
                        <i class="nav-icon fas fa-user-shield"></i>
                        <span>Vai trò & Quyền</span>
                        <i class="fas fa-chevron-right menu-arrow"></i>
                    </a>
                    <div class="collapse" id="roleSubmenu">
                        <div class="nav-submenu">
                            <a href="/Admin/ManageRole" class="nav-link-admin">
                                <i class="far fa-circle nav-icon" style="font-size:0.6rem;"></i>
                                <span>Danh sách quyền</span>
                            </a>
                            <a href="/Admin/ManageRole/SetRole" class="nav-link-admin">
                                <i class="far fa-circle nav-icon" style="font-size:0.6rem;"></i>
                                <span>Phân quyền (Set Role)</span>
                            </a>
                        </div>
                    </div>

                    <a href="/Admin/ManageUser/ChangePassword" class="nav-link-admin">
                        <i class="nav-icon fas fa-key"></i>
                        <span>Đổi mật khẩu</span>
                    </a>

                    <div class="nav-header">HỆ THỐNG</div>
                    <a href="/" target="_blank" class="nav-link-admin">
                        <i class="nav-icon fas fa-external-link-alt"></i>
                        <span>Xem Website</span>
                    </a>
                    <a href="/Account/Logout" class="nav-link-admin text-danger">
                        <i class="nav-icon fas fa-sign-out-alt text-danger"></i>
                        <span>Đăng xuất</span>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div id="main-wrapper">

            <!-- Topbar Header -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="topbar-toggle" id="sidebarToggle" aria-label="Thu gọn hoặc mở rộng thanh điều hướng bên" title="Thu gọn / Mở rộng sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="d-none d-md-flex align-items-center text-muted small">
                        <i class="fas fa-shield-alt text-warning me-2"></i>
                        <span>Hệ thống Quản trị LalaCoffee</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    <a href="/" target="_blank" class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center gap-2">
                        <i class="fas fa-external-link-alt"></i>
                        <span>Trang chủ Shop</span>
                    </a>

                    <!-- User Account Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2 px-2 py-1" type="button" id="adminUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="/Content/Layout/Admin/images/avatar.png" alt="Avatar" width="28" height="28" class="rounded-circle border">
                            <span class="d-none d-sm-inline fw-semibold text-dark">@User.Identity.GetUserName()</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" aria-labelledby="adminUserDropdown">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold text-dark">@User.Identity.GetUserName()</div>
                                <small class="text-muted">Quản trị viên hệ thống</small>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/Admin/ManageUser/ChangePassword">
                                    <i class="fas fa-key text-muted me-2"></i> Đổi mật khẩu
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/" target="_blank">
                                    <i class="fas fa-store text-muted me-2"></i> Ghé thăm cửa hàng
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-2 text-danger" href="/Account/Logout">
                                    <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Content Surface -->
            <main class="admin-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="admin-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>Copyright &copy; 2026 <a href="/" class="text-decoration-none text-brand-gold">LalaCoffee</a>.</strong> Tất cả quyền được bảo lưu.
                </div>
                <div class="text-muted">
                    Phiên bản quản trị chuẩn Bootstrap 5.3
                </div>
            </footer>

        </div>
    </div>

    <!-- Hidden Anti-Forgery Form for AJAX requests -->
    <form id="__AjaxAntiForgeryForm" action="#" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- Bootstrap 5.3 Bundle (includes Popper) -->
    <script src="/Content/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- AJAX & Dashboard Helpers -->
    <script src="/Content/Layout/Admin/js/ajax.js"></script>
    <script src="/Content/Layout/Admin/js/admin-dashboard.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
