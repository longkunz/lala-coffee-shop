    <link href="~/Content/Layout/User/css/revolution-plugin/extralayers.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/revolution-plugin/settings.css" rel="stylesheet">
    <link href="~/Content/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/bootstrap-plugin/bootstrap-slider.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/animation/animate.min.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/owl-carousel/owl.carousel.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/owl-carousel/owl.theme.default.css" rel="stylesheet">

    <link href="~/Content/Layout/User/css/light-box/simplelightbox.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/light-box/magnific-popup.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/scroll-bar/jquery.mCustomScrollbar.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/form-field/jquery.formstyler.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/slick-slider/slick-theme.css" rel="stylesheet">

    <link href="~/Content/Layout/User/css/style.css" rel="stylesheet">
    <link href="~/Content/Layout/User/css/responsive.css" rel="stylesheet">
    <script src="~/Content/Layout/User/js/jquery/jquery.min.js"></script>
    <link href="~/Content/Layout/User/css/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Content/Layout/User/js/sweetalert2/sweetalert2.min.js"></script>

</head>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomePage = (ViewBag.IsHomePage == true)
                  || (string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                      && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase));
}

<body class="storefront @(isHomePage ? "is-home-page" : "is-content-page")">

    <!-- Page pre loader -->
    @*<div id="pre-loader">
            <div class="loader-holder">
                <div class="frame">
                    <img src="~/Content/Layout/User/images/logo-cafe.gif" alt="LalaCoffee" />
                </div>
            </div>
        </div>*@

    <!-- Start Wrapper Part -->
    <div class="wrapper">
        <!-- Start Header Part -->
        <header>
            <div class="header-part @(isHomePage ? "header-overlay-hero" : "header-solid") header-reduce sticky storefront-header">
                <div class="header-nav">
                    <div class="container-fluid">
                        <div class="header-nav-inside">
                            <div class="logo">
                                <a href="@Url.Action("Index","Home")" class="d-inline-flex align-items-center" title="LalaCoffee">
                                    <img src="~/Content/Layout/User/images/lalacoffee-logo-horizontal-dark.png" alt="LalaCoffee" class="site-brand-logo" />
                                </a>
                            </div>
                            <div class="menu-top-part">
                                <div class="menu-nav-main">
                                    <ul>
                                        <li>
                                            <a href="@Url.Action("Index","Home")">Trang Chủ</a>
