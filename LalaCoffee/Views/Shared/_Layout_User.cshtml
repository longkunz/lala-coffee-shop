                                                            <a href="/collections/ca-phe-may" title="Cà Phê Sữa Đá">
                                                                Cà Phê Sữa Đá
                                                            </a>
                                                        </li>
                                                        <li class="lv3_title" main-menu-new-menu="" a_="">
                                                            <a href="/collections/cold-brew" title="Bạc Xỉu">
                                                                Bạc Xỉu
                                                            </a>
                                                        </li>
                                                    </ul>*@
                                            </ul>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Index","Blog")">Blog</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("About","Home")">Về Chúng Tôi</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Contact","Home")">Liên Hệ</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="cell-part">
                                    <a href="tel:0888888888"><span class="fa fa-phone"></span> 08 8888 8888</a>
                                </div>
                                <div class="cart animated header-account">
                                    <button type="button" class="header-icon" aria-label="Tài khoản" title="Tài khoản">
                                        <ion-icon name="person-outline" aria-hidden="true"></ion-icon>
                                    </button>
                                    <div class="cart-wrap account-dropdown-wrap">
                                        <div class="cart-blog account-dropdown-card">
                                            @if (@User.Identity.IsAuthenticated)
                                            {
                                                <div class="account-dropdown-header">
                                                    <span class="account-greeting">Xin chào, <strong class="account-username" title="@User.Identity.GetUserName()">@User.Identity.GetUserName()</strong></span>
                                                </div>
                                                <div class="account-dropdown-divider"></div>
                                                <ul class="account-dropdown-menu">
                                                    <li>
                                                        <a href="@Url.Action("Profile", "Account")" class="account-menu-link">
                                                            <i class="fa fa-user-circle-o" aria-hidden="true"></i>
                                                            <span>Thông tin tài khoản</span>
                                                        </a>
                                                    </li>
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <li>
                                                            <a href="@Url.Action("Index", "ManageOrder", new { area = "Admin" })" class="account-menu-link">
                                                                <i class="fa fa-tachometer" aria-hidden="true"></i>
                                                                <span>Quản lý admin</span>
                                                            </a>
                                                        </li>
                                                    }
                                                    <li>
                                                        <a href="@Url.Action("Logout", "Account")" class="account-menu-link text-danger">
                                                            <i class="fa fa-sign-out" aria-hidden="true"></i>
                                                            <span>Đăng xuất</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                            }
                                            else
                                            {
                                                <ul class="account-dropdown-menu">
                                                    <li>
                                                        <a href="@Url.Action("Login", "Account")" class="account-menu-link">
                                                            <i class="fa fa-sign-in" aria-hidden="true"></i>
                                                            <span>Đăng nhập</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a href="@Url.Action("Register", "Account")" class="account-menu-link">
                                                            <i class="fa fa-user-plus" aria-hidden="true"></i>
                                                            <span>Đăng ký</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <a href="@Url.Action("Index","Cart")" class="header-icon header-cart" aria-label="Giỏ hàng" title="Giỏ hàng">
                                    <ion-icon name="cart-outline" aria-hidden="true"></ion-icon>
                                    <span id="totalCart" class="header-cart-count">0</span>
                                </a>
                                @*<div class="cart animated">
                                        <span class="icon-basket fontello"><ion-icon name="cart-outline"></ion-icon></span>
                                        <div class="cart-wrap">
                                            <div class="cart-blog">
                                                <div class="cart-item">
                                                    <div class="cart-item-left">
                                                        <img src="~/Content/Layout/User/images/ca-phe-sua-da.jpg" alt="">
                                                    </div>
                                                    <div class="cart-item-right">
                                                        <h6>Cà Phê Sữa Đá</h6>
                                                        <span>39.000đ</span>
                                                    </div>
                                                    <span class="delete-icon"></span>
                                                </div>
                                                <div class="cart-item">
