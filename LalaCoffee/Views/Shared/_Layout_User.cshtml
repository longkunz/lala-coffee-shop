    <script src="~/Content/Layout/User/js/revolution-plugin/jquery.themepunch.revolution.min.js"></script>
    <script src="~/Content/Layout/User/js/parallax-stellar/jquery.stellar.js"></script>
    <script src="~/Content/Layout/User/js/animation/wow.min.js"></script>
    <script src="~/Content/Layout/User/js/owl-carousel/owl.carousel.min.js"></script>
    <script src="~/Content/Layout/User/js/light-box/simple-lightbox.min.js"></script>
    <script src="~/Content/Layout/User/js/light-box/jquery.magnific-popup.min.js"></script>
    <script src="~/Content/Layout/User/js/scroll-bar/jquery.mCustomScrollbar.concat.min.js"></script>
    <script src="~/Content/Layout/User/js/masonry/isotop.js"></script>
    <script src="~/Content/Layout/User/js/masonry/packery-mode.pkgd.min.js"></script>
    <script src="~/Content/Layout/User/js/form-field/jquery.formstyler.min.js"></script>
    <script src="~/Content/Layout/User/js/slick-slider/slick.min.js"></script>
    <script src="~/Content/Layout/User/js/progress-circle/waterbubble.min.js"></script>
    <script src="~/Content/Layout/User/js/app.js"></script>
    <script src="~/Content/Layout/User/js/script.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script type="text/javascript">
    function getTotalCart() {
        $.ajax({
            type: 'GET',
            url: "@Url.Action("GetTotal", "Cart")",
            success: function (result) {
                $("#totalCart").html(result.total);
            }
        });
    }
    getTotalCart();
    </script>
</body>

</html>
