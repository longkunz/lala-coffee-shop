                            <div class="col-lg-3 col-md-6 col-sm-6 col-12 mb-4">
                                <h5>Theo Dõi Chúng Tôi</h5>
                                <p style="margin-bottom: 15px; color: #e0d5cb; font-size: 14px; line-height: 1.6;">
                                    Kết nối cùng LalaCoffee để nhận thông tin thức uống mới, câu chuyện văn hóa cà phê và những ưu đãi hấp dẫn.
                                </p>
                                <ul class="footer-social" style="margin-bottom: 18px;">
                                    <li style="margin-right: 10px;"><a href="#" title="Facebook" style="display: inline-block; width: 36px; height: 36px; line-height: 36px; text-align: center; border-radius: 50%; background: rgba(255,255,255,0.1); color: #fff; transition: all 0.3s;"><i class="fa fa-facebook" aria-hidden="true"></i></a></li>
                                    <li style="margin-right: 10px;"><a href="#" title="Instagram" style="display: inline-block; width: 36px; height: 36px; line-height: 36px; text-align: center; border-radius: 50%; background: rgba(255,255,255,0.1); color: #fff; transition: all 0.3s;"><i class="fa fa-instagram" aria-hidden="true"></i></a></li>
                                    <li style="margin-right: 10px;"><a href="#" title="TikTok" style="display: inline-block; width: 36px; height: 36px; line-height: 36px; text-align: center; border-radius: 50%; background: rgba(255,255,255,0.1); color: #fff; transition: all 0.3s;"><i class="fa fa-music" aria-hidden="true"></i></a></li>
                                    <li><a href="#" title="YouTube" style="display: inline-block; width: 36px; height: 36px; line-height: 36px; text-align: center; border-radius: 50%; background: rgba(255,255,255,0.1); color: #fff; transition: all 0.3s;"><i class="fa fa-youtube-play" aria-hidden="true"></i></a></li>
                                </ul>
                                <div class="footer-newsletter">
                                    <form onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã đăng ký nhận tin từ LalaCoffee!');">
                                        <div class="input-group" style="max-width: 320px;">
                                            <input type="email" class="form-control" placeholder="Nhập email của bạn..." required style="height: 38px; font-size: 13px; background: rgba(255,255,255,0.9); border: none; border-radius: 20px 0 0 20px; padding-left: 15px; color: #333;" />
                                            <button type="submit" class="btn" style="height: 38px; background: #c19942; color: #fff; border: none; border-radius: 0 20px 20px 0; padding: 0 16px; font-weight: 600;">Gửi</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="copyright">
                    <div class="container-fluid" style="padding-left: clamp(20px, 4vw, 60px); padding-right: clamp(20px, 4vw, 60px);">
                        <p style="margin: 0; color: #9c8e82;">Copyright © 2026 by LalaCoffee. All rights reserved.</p>
                    </div>
                </div>
