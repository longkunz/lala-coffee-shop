                                                        <div class="col-md-6 col-sm-6 col-xs-6">
                                                            <h6>Tổng tiền: </h6>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 col-xs-6">
                                                            <span>140.000đ</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="cart-btn">
                                                    <a href="@Url.Action("Index","Cart")" class="button-default view">Giỏ hàng</a>
                                                    <a href="@Url.Action("CheckOut","Order")" class="button-default checkout">Thanh toán</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>*@
                                <div class="menu-icon">
                                    <a href="#" class="hambarger">
                                        <span class="bar-1"></span>
