            <div class="footer-part">
                <div class="footer-inner-info Banner-Bg" data-background="/Content/Layout/User/images/footer-bg-new.jpg" style="position: relative; background-size: cover; background-position: center;">
                    <div style="position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(to bottom, rgba(16, 10, 8, 0.88) 0%, rgba(12, 7, 5, 0.94) 100%); pointer-events: none;"></div>
                    <div class="container-fluid" style="position: relative; z-index: 1; padding-left: clamp(20px, 4vw, 60px); padding-right: clamp(20px, 4vw, 60px);">
                        <div class="row">
                            <!-- Cột 1: Thông tin thương hiệu -->
                            <div class="col-lg-3 col-md-6 col-sm-6 col-12 mb-4">
                                <div class="logo">
                                    <a href="@Url.Action("Index","Home")" class="d-inline-flex align-items-center" title="LalaCoffee">
                                        <img src="~/Content/Layout/User/images/lalacoffee-logo-horizontal-dark.png" alt="LalaCoffee" class="site-brand-logo footer-logo" />
                                    </a>
                                </div>
                                <p style="line-height: 1.7; margin-bottom: 15px; color: #e0d5cb;">
                                    Hương vị cà phê mộc nguyên bản từ nông trại Tây Nguyên. LalaCoffee đồng hành cùng bạn trong từng khoảnh khắc thư thái và sáng tạo mỗi ngày.
                                </p>
                                <p style="font-size: 14px; color: #c7a17a; margin-bottom: 0;">
                                    <i class="fa fa-clock-o mr-1"></i> Mở cửa: 07:00 – 22:30 (Mỗi ngày)
                                </p>
                            </div>

                            <!-- Cột 2: Thông tin liên hệ -->
                            <div class="col-lg-3 col-md-6 col-sm-6 col-12 mb-4">
                                <h5>Thông Tin Liên Hệ</h5>
                                <div style="line-height: 2.1; color: #e0d5cb;">
                                    <div><i class="fa fa-map-marker text-warning mr-2" style="width: 18px;"></i> 783 Võ Văn Kiệt, Phường Chợ Quán, TPHCM</div>
                                    <div><a href="tel:0888888888"><i class="fa fa-phone text-warning mr-2" style="width: 18px;"></i> 08 8888 8888</a></div>
                                    <div><a href="mailto:admin@lalacoffee.vn"><i class="fa fa-envelope text-warning mr-2" style="width: 18px;"></i> admin@lalacoffee.vn</a></div>
                                    <div><i class="fa fa-globe text-warning mr-2" style="width: 18px;"></i> www.lalacoffee.vn</div>
                                </div>
                            </div>

                            <!-- Cột 3: Khám phá -->
                            <div class="col-lg-3 col-md-6 col-sm-6 col-12 mb-4">
                                <h5>Khám Phá Lala</h5>
                                <div style="line-height: 2.1;">
                                    <div><a href="@Url.Action("Index","Home")">Trang chủ</a></div>
                                    <div><a href="@Url.Action("About","Home")">Về chúng tôi</a></div>
                                    <div><a href="/Collections/All">Thực đơn đồ uống</a></div>
                                    <div><a href="@Url.Action("Index","Blog")">Chuyện cà phê (Blog)</a></div>
                                    <div><a href="@Url.Action("Contact","Home")">Liên hệ hợp tác</a></div>
                                </div>
                            </div>

