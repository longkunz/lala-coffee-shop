@model LalaCoffee.Models.Blog

@{
    ViewBag.Title = "Chỉnh sửa bài viết";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    var fieldErrors = (ViewBag.FieldErrors ?? TempData["FieldErrors"]) as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
}
@Html.Partial("ErrorsAlert")
<script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
<script type="text/javascript">
    // Guard: nếu CDN không tải được (mất mạng) thì bỏ qua cấu hình CKEditor,
    // textarea thường vẫn nhập và lưu được nội dung thay vì lỗi JS sập trang.
    if (window.CKEDITOR) {
        CKEDITOR.config.versionCheck = false;
    }
</script>
<style>
    .cke_notification_warning, .cke_display_version_check, .cke_display_version_check-absolute {
        display: none !important;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fa fa-edit"></i> CHỈNH SỬA BÀI VIẾT: (@Model.Title)
                </h3>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                <div class="card-body">
                    <div class="form-group">
                        <label>Tiêu đề <span class="text-danger">*</span></label>
                        <input class="form-control @(fieldErrors.ContainsKey("Title") ? "is-invalid" : "")" id="Title" name="Title" type="text" value="@Model.Title">
                        @if (fieldErrors.ContainsKey("Title"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["Title"]</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Nội dung <span class="text-danger">*</span></label>
                        <textarea class="form-control @(fieldErrors.ContainsKey("Content") ? "is-invalid" : "")" id="Content" name="Content" rows="3">@Model.Content</textarea>
                        @if (fieldErrors.ContainsKey("Content"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["Content"]</span>
                        }
                        <script type="text/javascript">
                            if (window.CKEDITOR) {
                                CKEDITOR.replace('Content', {
                                    versionCheck: false
                                });
                            }
                        </script>
                    </div>
                    <div class="form-group">
                        <label>Người đăng <span class="text-danger">*</span></label>
                        <input class="form-control @(fieldErrors.ContainsKey("Author") ? "is-invalid" : "")" id="Author" name="Author" type="text" value="@Model.Author">
                        @if (fieldErrors.ContainsKey("Author"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["Author"]</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Hình ảnh</label>
                        <input class="form-control" id="image" name="image" type="text" value="@Model.Image">
                        <div class="input-group form-group">
                            <input type="file" name="fileUpload" id="fileUpload" accept="image/*"
                                   style="display:none;" />
                            <span class="input-group-btn">
                                <input type="button" id="btnUpload" value="Chọn" class="btn btn-success" />
                            </span>
                        </div>
                        <img src="@Model.Image" id="pictureUpload" class="img-fluid" />
                    </div>
                    <div class="form-group">
                        <label>Hiện hành</label>
                        @if (Model.Published)
                        {
                            <input type="checkbox" name="Published" id="Published" value="true" checked>
                        }
                        else
                        {
                            <input type="checkbox" name="Published" id="Published" value="true">
                        }
                        <label class="form-check-label" for="Published">ON</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a href="@Url.Action("Index", "ManageBlog")" class="btn btn-secondary ml-2">Quay lại</a>
                </div>
            }
        </div>
    </div>
</div>
<script>
    $(function () {
        $('#btnUpload').click(function () {
            $('#fileUpload').trigger('click');
        });
    });
    $('#fileUpload').change(function () {
        if (window.FormData !== undefined) {
            var fileUpload = $('#fileUpload').get(0);
            var files = fileUpload.files;
            var formData = new FormData();
            formData.append('file', files[0]);

            $.ajax(
                {
                    type: 'POST',
                    url: '/Image/ProcessUpload',
                    contentType: false,
                    processData: false,
                    data: formData,
                    success: function (urlImage) {

                        $('#pictureUpload').attr('src', urlImage);
                        $('#image').val(urlImage);
                    },
                    error: function (err) {
                        alert('Error ', err.statusText);
                    }
                });
        }
    });
</script>
