@model IEnumerable<Microsoft.AspNet.Identity.EntityFramework.IdentityRole>
@{
    ViewBag.Title = "Role Manager";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    var systemRoles = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Admin", "User" };
    var fieldErrors = (TempData["FieldErrors"] ?? ViewBag.FieldErrors) as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var formValues = (TempData["FormValues"] ?? ViewBag.FormValues) as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    string openModal = TempData["OpenModal"] as string;
}
@Html.Partial("ErrorsAlert")
<div class="modal fade" id="create_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "ManageRole", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h4 class="modal-title">Tạo vai trò mới</h4>
                    <button type="button" class="close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="card-body table-responsive p-0">
                        <div class="form-group">
                            <label>Tên vai trò <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(fieldErrors.ContainsKey("name") ? "is-invalid" : "")" name="name" id="name" placeholder="Nhập tên vai trò..." value="@(formValues.ContainsKey("name") ? formValues["name"] : "")">
                            @if (fieldErrors.ContainsKey("name"))
                            {
                                <span class="invalid-feedback d-block">@fieldErrors["name"]</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            }
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fa fa-list"></i> DANH SÁCH ROLE <a data-bs-toggle="modal" data-toggle="modal" data-bs-target="#create_modal" data-target="#create_modal" style="cursor: pointer;"><i class="fa fa-plus-circle"></i></a>
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-info py-2 mb-3">
                    <i class="fas fa-shield-alt mr-1"></i>
                    <strong>Bảo vệ role hệ thống:</strong> Các role mặc định như <code>Admin</code> và <code>User</code> được hệ thống bảo vệ nghiêm ngặt để đảm bảo an toàn truy cập và không thể xóa.
                </div>
                <div class="card-body table-responsive p-0">
                    <table class="table table-head-fixed text-nowrap" id="nTable">
                        <thead>
                            <tr>
                                <th style="width: 100px;">Hành động</th>
                                <th>Id</th>
                                <th>Tên</th>
                                <th>Phân loại</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var isSystem = systemRoles.Contains(item.Name);
                                <tr>
                                    <td>
                                        @if (isSystem)
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm" disabled title="Role hệ thống được bảo vệ, không thể xóa">
                                                <i class="fas fa-lock"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0)" class="btn btn-danger btn-sm" onclick="del('@item.Id', '@item.Name')" title="Xóa role">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        }
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Id)
                                    </td>
                                    <td>
                                        <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                    </td>
                                    <td>
                                        @if (isSystem)
                                        {
                                            <span class="badge badge-info"><i class="fas fa-shield-alt"></i> Role hệ thống</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Tùy biến</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function del(id, roleName) {
        if (confirm("Bạn chắc chắn muốn xóa role '" + roleName + "'?")) {
            $.ajax({
                url: "@Url.Action("Delete", "ManageRole")",
                type: "POST",
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert("Lỗi: " + error);
                }
            });
        }
    }
    @if (!string.IsNullOrEmpty(openModal) && fieldErrors.Count > 0)
    {
        <text>
        $(document).ready(function () {
            $('#@openModal').modal('show');
        });
        </text>
    }
</script>
