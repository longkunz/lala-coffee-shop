@model LalaCoffee.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    bool isActive = Model.Status == "1" 
        || string.Equals(Model.Status, "Show", StringComparison.OrdinalIgnoreCase) 
        || string.Equals(Model.Status, "Active", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Status, "True", StringComparison.OrdinalIgnoreCase);
}
@{
    var fieldErrors = (ViewBag.FieldErrors ?? TempData["FieldErrors"]) as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
}
@Html.Partial("ErrorsAlert")

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Chỉnh sửa Danh mục</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb admin-breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/ManageOrder" class="text-decoration-none text-muted">Quản trị</a></li>
                <li class="breadcrumb-item"><a href="/Admin/ManageCategory" class="text-decoration-none text-muted">Danh mục</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Index", "ManageCategory")" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fas fa-arrow-left"></i>
        <span>Quay lại danh sách</span>
    </a>
</div>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0">
                    <i class="fas fa-edit me-2"></i> Thông tin danh mục: <strong>@Model.Name</strong>
                </h5>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="name">Tên danh mục <span class="text-danger">*</span></label>
                        <input class="form-control @(fieldErrors.ContainsKey("name") ? "is-invalid" : "")" id="name" name="name" type="text" value="@Model.Name" onchange="getSlug()">
                        @if (fieldErrors.ContainsKey("name"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["name"]</span>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="slug">Đường dẫn thân thiện (Slug) <span class="text-danger">*</span></label>
                        <input class="form-control @(fieldErrors.ContainsKey("slug") ? "is-invalid" : "")" id="slug" name="slug" type="text" value="@Model.Slug">
                        @if (fieldErrors.ContainsKey("slug"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["slug"]</span>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="description">Mô tả danh mục</label>
                        <textarea class="form-control" id="description" name="description" rows="3">@Model.Description</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="parentid">Danh mục cha</label>
                        <select class="form-select" name="parentid" id="parentid">
                            <option value="0">-- Danh mục gốc --</option>
                            @foreach (var parent in ViewBag.Categories)
                            {
                                <option value="@parent.Id" @(Model.ParentId == parent.Id ? "selected" : "")>@parent.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mt-3 mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" name="status" id="status" value="1" @(isActive ? "checked" : "")>
                        <label class="form-check-label fw-semibold" for="status">Cho phép hiển thị trên thanh thực đơn</label>
                    </div>
                </div>
                <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("Index", "ManageCategory")" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
    function removeDiacritics(str) {
        str = str.replace(/Đ/g, "D");
        str = str.replace(/đ/g, "d");
        str = str.replace(/ /g, "-");
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }
    function getSlug() {
        var name = $('#name').val();
        var result = removeDiacritics(name);
        $('#slug').val(result.toLowerCase());
    }
</script>
