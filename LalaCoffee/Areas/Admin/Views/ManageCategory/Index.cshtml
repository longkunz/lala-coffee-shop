@model IEnumerable<LalaCoffee.Models.Category>

@{
    ViewBag.Title = "Category Manager";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}
@functions{
    public static bool IsActive(string active)
    {
        if (string.IsNullOrWhiteSpace(active)) return false;
        return active == "1" 
            || string.Equals(active, "Show", StringComparison.OrdinalIgnoreCase) 
            || string.Equals(active, "Active", StringComparison.OrdinalIgnoreCase)
            || string.Equals(active, "True", StringComparison.OrdinalIgnoreCase);
    }
    public string NorActive(string active = "1")
    {
        return IsActive(active) ? "<span class='btn btn-success btn-xs'>ON</span>" : "<span class='btn btn-danger btn-xs'>OFF</span>";
    }
    public string ParentCategory(int parentId)
    {
        foreach(var item in Model)
        {
            if(item.Id == parentId)
            {
                return item.Name;
            }
        }
        return "Danh mục cha";
    }
}
@{
    var fieldErrors = (TempData["FieldErrors"] ?? ViewBag.FieldErrors) as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var formValues = (TempData["FormValues"] ?? ViewBag.FormValues) as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    string openModal = TempData["OpenModal"] as string;
    bool isCreateActive = !formValues.ContainsKey("status") || formValues["status"] == "1";
    string selectedParent = formValues.ContainsKey("parentid") ? formValues["parentid"] : "0";
}
@Html.Partial("ErrorsAlert")
<div class="modal fade" id="create_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "ManageCategory", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h4 class="modal-title">Tạo danh mục mới</h4>
                    <button type="button" class="close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="card-body table-responsive p-0">
                        <div class="form-group">
                            <label>Tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(fieldErrors.ContainsKey("name") ? "is-invalid" : "")" name="name" id="name" value="@(formValues.ContainsKey("name") ? formValues["name"] : "")" onchange="getSlug();">
                            @if (fieldErrors.ContainsKey("name"))
                            {
                                <span class="invalid-feedback d-block">@fieldErrors["name"]</span>
                            }
                        </div>
                        <div class="form-group">
                            <label>Slug <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(fieldErrors.ContainsKey("slug") ? "is-invalid" : "")" name="slug" id="slug" value="@(formValues.ContainsKey("slug") ? formValues["slug"] : "")">
                            @if (fieldErrors.ContainsKey("slug"))
                            {
                                <span class="invalid-feedback d-block">@fieldErrors["slug"]</span>
                            }
                        </div>
                        <div class="form-group">
                            <label>Mô tả <span class="text-danger">*</span></label>
                            <textarea rows="5" class="form-control @(fieldErrors.ContainsKey("description") ? "is-invalid" : "")" name="description" id="description">@(formValues.ContainsKey("description") ? formValues["description"] : "")</textarea>
                            @if (fieldErrors.ContainsKey("description"))
                            {
                                <span class="invalid-feedback d-block">@fieldErrors["description"]</span>
                            }
                        </div>
                        <div class="form-group">
                            <label>Danh mục cha</label>
                            <select class="form-control" name="parentid" id="parentid">
                                <option value="0" @(selectedParent == "0" ? "selected" : "")>Danh mục cha</option>
                                @foreach(var item in Model) { 
                                <option value="@item.Id" @(selectedParent == item.Id.ToString() ? "selected" : "")>@item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Trạng thái</label>
                            <input type="checkbox" name="status" id="status" value="1" @(isCreateActive ? "checked" : "")>
                            <label class="form-check-label" for="status">ON</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            }
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fa fa-list"></i> DANH SÁCH DANH MỤC <a data-bs-toggle="modal" data-toggle="modal" data-bs-target="#create_modal" data-target="#create_modal"><i class="fa fa-plus-circle"></i></a>
                </h3>
            </div>
            <div class="card-body">
                <div class="card-body table-responsive p-0">
                    <table class="table table-head-fixed text-nowrap" id="nTable">
                        <thead>
                            <tr>
                                <th>Hành động</th>
                                <th>Id</th>
                                <th>Tên</th>
                                <th>Slug</th>
                                <th>Danh mục cha</th>
                                <th>Trạng thái</th>
                                <th>CreatedAt</th>
                                <th>UpdatedAt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Edit", "ManageCategory", new { id = item.Id })" class="btn btn-primary btn-sm">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a href="#" class="btn btn-danger btn-sm" onclick="del('@item.Id')">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Slug)</td>
                                    <td>@ParentCategory(item.ParentId)</td>
                                    <td>@Html.Raw(NorActive(item.Status))</td>
                                    <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                                    <td>@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function removeDiacritics(str) {
        str = str.replace(/Đ/g, "D");
        str = str.replace(/đ/g, "d");
        str = str.replace(/ /g, "-"); // replace space to "-"
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }
    function getSlug() {
        var name = $('#name').val();
        var result = removeDiacritics(name);
        $('#slug').val(result.toLowerCase());
    }
    function del(id) {
        if (confirm("Bạn chắc chắn muốn xóa?")) {
            $.ajax({
                url: "@Url.Action("Delete", "ManageCategory")",
                type: "POST",
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {if (response.success) {    alert(response.message);    location.reload();} else {    alert(response.message);}
                },
                error: function (xhr, status, error) {alert(error);
                }
            });
        }
    }
    @if (!string.IsNullOrEmpty(openModal) && fieldErrors.Count > 0)
    {
        <text>
        $(document).ready(function () {
            $('#@openModal').modal('show');
        });
        </text>
    }
</script>
