@model IEnumerable<LalaCoffee.Models.Order>
@using LalaCoffee.Models

@{
    ViewBag.Title = "Order Manager";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@Html.Partial("ErrorsAlert")
@Html.AntiForgeryToken()
<div class="row">
    <div class="col-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fa fa-list"></i> DANH SÁCH ĐƠN HÀNG
                </h3>
            </div>
            <div class="card-body">
                <div class="card-body table-responsive p-0" style="text-align: center">
                    <table class="table table-head-fixed text-nowrap" id="orderTable" data-server-side="true" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Hành động</th>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Số điện thoại</th>
                                <th>Địa chỉ</th>
                                <th>PTTT</th>
                                <th>Thanh toán</th>
                                <th>Ghi chú</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái đơn</th>
                                <th>Ngày tạo</th>
                                <th>Cập nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var orderTable;
    $(document).ready(function () {
        orderTable = $('#orderTable').DataTable({
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "@Url.Action("GetData", "ManageOrder")",
                "type": "POST",
                "data": function (d) {
                    d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
                }
            },
            "columns": [
                {
                    "data": "id",
                    "orderable": false,
                    "searchable": false,
                    "render": function (data, type, row) {
                        return '<a href="' + row.detailUrl + '" class="btn btn-info btn-sm mr-1" title="Chi tiết"><i class="fa fa-eye"></i></a> ' +
                               '<a href="' + row.editUrl + '" class="btn btn-primary btn-sm mr-1" title="Chỉnh sửa"><i class="fa fa-edit"></i></a> ' +
                               '<a href="#" class="btn btn-danger btn-sm" onclick="del(\'' + data + '\')" title="Xóa"><i class="fa fa-trash"></i></a>';
                    }
                },
                {
                    "data": "code",
                    "render": function (data) {
                        return '<strong>' + (data ? data : '') + '</strong>';
                    }
                },
                { "data": "name" },
                { "data": "phoneNumber" },
                { "data": "address" },
                {
                    "data": "payment",
                    "render": function (data) {
                        var pType = (data || 'cash').toLowerCase();
                        return '<img style="width:24px; height:24px; object-fit:contain;" src="/Content/images/payment/' + pType + '.png" alt="' + (data || '') + '" title="' + (data || '') + '">';
                    }
                },
                {
                    "data": "paidBadge",
                    "render": function (data) { return data; }
                },
                { "data": "note" },
                {
                    "data": "totalFormatted",
                    "render": function (data) {
                        return '<strong class="text-success">' + data + '</strong>';
                    }
                },
                {
                    "data": "statusBadge",
                    "render": function (data) { return data; }
                },
                { "data": "createdAt" },
                { "data": "updatedAt" }
            ],
            "order": [[10, "desc"]],
            "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
            "language": {
                "processing": "Đang tải dữ liệu...",
                "lengthMenu": "Hiển thị _MENU_ mục",
                "zeroRecords": "Không tìm thấy dữ liệu",
                "info": "Hiển thị từ _START_ đến _END_ của _TOTAL_ mục",
                "infoEmpty": "Hiển thị từ 0 đến 0 của 0 mục",
                "infoFiltered": "(được lọc từ _MAX_ mục)",
                "search": "Tìm kiếm:",
                "paginate": {
                    "first": "Đầu",
                    "previous": "Trước",
                    "next": "Tiếp",
                    "last": "Cuối"
                }
            }
        });
    });

    function del(id) {
        if (confirm("Bạn chắc chắn muốn xóa đơn hàng này?")) {
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: "@Url.Action("Delete", "ManageOrder")",
                type: "POST",
                data: {
                    id: id,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        if (orderTable) {
                            orderTable.ajax.reload(null, false);
                        } else {
                            location.reload();
                        }
                    } else {
                        alert(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert(error);
                }
            });
        }
    }
</script>
