@model IEnumerable<LalaCoffee.Models.OrderDetail>
@using LalaCoffee.Models
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    var order = ViewBag.Order as Order;
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Chi tiết Đơn hàng</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb admin-breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/ManageOrder" class="text-decoration-none text-muted">Quản trị</a></li>
                <li class="breadcrumb-item"><a href="/Admin/ManageOrder" class="text-decoration-none text-muted">Đơn hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(order != null ? order.Code : "")</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        @if (order != null)
        {
            <a href="@Url.Action("Edit", "ManageOrder", new { id = order.Id })" class="btn btn-warning d-inline-flex align-items-center gap-2">
                <i class="fas fa-edit"></i>
                <span>Cập nhật trạng thái</span>
            </a>
        }
        <a href="@Url.Action("Index", "ManageOrder")" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="fas fa-arrow-left"></i>
            <span>Quay lại</span>
        </a>
    </div>
</div>

@if (order != null)
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="card-title mb-0">
                <i class="fas fa-info-circle text-primary me-2"></i> Thông tin đơn hàng: <span class="badge bg-light text-dark border ms-1">@order.Code</span>
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-4 border-end-md">
                    <h6 class="text-uppercase text-secondary fw-bold small mb-3">Người nhận hàng</h6>
                    <div class="mb-2"><strong>Họ tên:</strong> @order.Name</div>
                    <div class="mb-2"><strong>Số điện thoại:</strong> <a href="tel:@order.PhoneNumber" class="text-decoration-none">@order.PhoneNumber</a></div>
                    <div><strong>Địa chỉ:</strong> @order.Address</div>
                </div>
                <div class="col-md-4 border-end-md">
                    <h6 class="text-uppercase text-secondary fw-bold small mb-3">Thanh toán & Trạng thái</h6>
                    <div class="mb-2 d-flex align-items-center gap-2">
                        <strong>Phương thức:</strong>
                        <img style="width:20px; height:20px; object-fit:contain;" src="/Content/images/payment/@((order.Payment ?? "cash").ToLower()).png" alt="@order.Payment">
                        <span>@order.Payment</span>
                    </div>
                    <div class="mb-2"><strong>Thanh toán:</strong> @Html.Raw(OrderStatus.GetPaidBadge(order.Paid))</div>
                    <div><strong>Trạng thái đơn:</strong> @Html.Raw(OrderStatus.GetStatusBadge(order.Status))</div>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase text-secondary fw-bold small mb-3">Tổng kết & Ghi chú</h6>
                    <div class="mb-2"><strong>Tổng giá trị:</strong> <span class="text-success fw-bold fs-5">@order.Total.ToString("N0")đ</span></div>
                    <div class="mb-2"><strong>Thời gian đặt:</strong> @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    <div><strong>Ghi chú:</strong> <span class="text-muted">@(string.IsNullOrEmpty(order.Note) ? "(Không có)" : order.Note)</span></div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="card-title mb-0">
            <i class="fas fa-coffee me-2"></i> Danh sách món trong đơn hàng
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive p-3">
            <table class="table table-hover align-middle mb-0" id="nTable">
                <thead>
                    <tr>
                        <th style="width: 50px;">ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Kích cỡ (Size)</th>
                        <th>Topping thêm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var product = item.Product;
                        decimal itemPrice = item.Price;
                        decimal propertyPrice = item.PropertyPrice;
                        decimal optionsPrice = item.OptionPrice;
                        decimal unitTotal = itemPrice + propertyPrice + optionsPrice;
                        decimal lineTotal = unitTotal * item.Quantity;

                        <tr>
                            <td>@item.Id</td>
                            <td>
                                @if (product != null && !string.IsNullOrEmpty(product.Image))
                                {
                                    <img src="@product.Image" alt="@item.ProductName" style="width:48px; height:48px; object-fit:cover; border-radius:8px; border:1px solid #e2e8f0;" />
                                }
                                else
                                {
                                    <span class="text-muted small">Không có ảnh</span>
                                }
                            </td>
                            <td>
                                <strong>@item.ProductName</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PropertyName))
                                {
                                    <span class="badge bg-light text-dark border">@item.PropertyName (+@propertyPrice.ToString("N0")đ)</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.OptionName))
                                {
                                    <span class="badge bg-light text-dark border">@item.OptionName (+@optionsPrice.ToString("N0")đ)</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@unitTotal.ToString("N0")đ</td>
                            <td><span class="badge bg-secondary px-2 py-1">x@item.Quantity</span></td>
                            <td><strong class="text-success">@lineTotal.ToString("N0")đ</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
