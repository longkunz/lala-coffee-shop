@model IEnumerable<LalaCoffee.Models.OrderDetail>
@using LalaCoffee.Models
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    var order = ViewBag.Order as Order;
}

<div class="row">
    <div class="col-12">
        @if (order != null)
        {
            <div class="card card-info">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-info-circle mr-1"></i> THÔNG TIN ĐƠN HÀNG: <strong>@order.Code</strong>
                    </h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Edit", "ManageOrder", new { id = order.Id })" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit mr-1"></i> Chỉnh sửa
                        </a>
                        <a href="@Url.Action("Index", "ManageOrder")" class="btn btn-secondary btn-sm ml-1">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <p><strong>Người nhận:</strong> @order.Name</p>
                            <p><strong>Số điện thoại:</strong> @order.PhoneNumber</p>
                            <p><strong>Địa chỉ:</strong> @order.Address</p>
                        </div>
                        <div class="col-md-4">
                            <p>
                                <strong>Phương thức TT:</strong>
                                <img style="width:20px; height:20px; margin-right:4px;" src="/Content/images/payment/@((order.Payment ?? "cash").ToLower()).png" alt="@order.Payment">
                                @order.Payment
                            </p>
                            <p><strong>Thanh toán:</strong> @Html.Raw(OrderStatus.GetPaidBadge(order.Paid))</p>
                            <p><strong>Trạng thái đơn:</strong> @Html.Raw(OrderStatus.GetStatusBadge(order.Status))</p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Tổng tiền:</strong> <strong class="text-success font-weight-bold" style="font-size:18px;">@order.Total.ToString("N0")đ</strong></p>
                            <p><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(order.Note) ? "(Không có)" : order.Note)</p>
                            <p><strong>Thời gian tạo:</strong> @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card card-secondary">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-coffee mr-1"></i> DANH SÁCH MÓN TRONG ĐƠN HÀNG
                </h3>
            </div>
            <div class="card-body table-responsive p-0" style="text-align: center">
                <table class="table table-head-fixed text-nowrap" id="nTable">
                    <thead>
                        <tr>
                            <th>Mã SP</th>
                            <th>Tên sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thuộc tính</th>
                            <th>Tùy chọn thêm</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProductId</td>
                                    <td class="text-left font-weight-bold">@item.ProductName</td>
                                    <td>@item.Price.ToString("N0")đ</td>
                                    <td><span class="badge badge-secondary p-2">@item.Quantity</span></td>
                                    <td>@item.PropertyProduct</td>
                                    <td>@item.OptionProduct</td>
                                    <td class="font-weight-bold text-success">@item.Total.ToString("N0")đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (order != null)
            {
                <div class="card-footer text-right">
                    <h5>Tổng cộng: <strong class="text-danger">@order.Total.ToString("N0")đ</strong></h5>
                </div>
            }
        </div>
    </div>
</div>
