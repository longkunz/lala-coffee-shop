@model LalaCoffee.Models.OptionProduct

@{
    ViewBag.Title = "Edit Property Product";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    bool isActive = Model.Status == "1" 
        || string.Equals(Model.Status, "Show", StringComparison.OrdinalIgnoreCase) 
        || string.Equals(Model.Status, "Active", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Status, "True", StringComparison.OrdinalIgnoreCase);
}
@Html.Partial("ErrorsAlert")
<div class="row">
    <div class="col-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fa fa-edit"></i> CHỈNH SỬA TÙY CHỌN SẢN PHẨM: @(Model.Product != null ? Model.Product.Name : "") (@Model.Name)
                </h3>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                <div class="card-body">
                    <div class="form-group">
                        <label>Tên</label>
                        <input class="form-control" id="name" name="name" type="text" value="@Html.DisplayFor(item => item.Name)" onchange="getSlug()">
                    </div>
                    <div class="form-group">
                        <label>Giá</label>
                        <input class="form-control" id="price" name="price" type="number" step="any" min="0" value="@Model.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture)">
                    </div>
                    <div class="form-group">
                        <label>Sản phẩm</label>
                        <select class="form-control" name="product_id">
                            @if (Model.Product != null)
                            {
                                <option value="@Model.Product.Id">Giữ nguyên: @Model.Product.Name</option>
                            }
                            @foreach (var product in ViewBag.Product)
                            {
                                <option value="@product.Id">@product.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Trạng thái</label>
                        <input type="checkbox" name="status" id="status" value="1" @(isActive ? "checked" : "")>
                        <label class="form-check-label" for="status">ON</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
    function removeDiacritics(str) {
        str = str.replace(/Đ/g, "D");
        str = str.replace(/đ/g, "d");
        str = str.replace(/ /g, "-"); // replace space to "-"
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }
    function getSlug() {
        var name = $('#name').val();
        var result = removeDiacritics(name);
        $('#slug').val(result.toLowerCase());
    }
</script>
