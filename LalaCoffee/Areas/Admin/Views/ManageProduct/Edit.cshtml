@model LalaCoffee.Models.Product

@{
    ViewBag.Title = "Edit Product";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    bool isActive = Model.Status == "1" 
        || string.Equals(Model.Status, "Show", StringComparison.OrdinalIgnoreCase) 
        || string.Equals(Model.Status, "Active", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Status, "True", StringComparison.OrdinalIgnoreCase);
}
@functions{
    public string ParentCategory(int parentId)
    {
        if (ViewBag.Categories != null)
        {
            foreach(var item in ViewBag.Categories)
            {
                if(item.Id == parentId)
                {
                    return item.Name;
                }
            }
        }
        return "Danh mục cha";
    }
}
@{
    var fieldErrors = (ViewBag.FieldErrors ?? TempData["FieldErrors"]) as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    string priceVal = ViewBag.PriceInput != null ? (string)ViewBag.PriceInput : Model.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
}
@Html.Partial("ErrorsAlert")
<div class="row">
    <div class="col-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fa fa-edit"></i> CHỈNH SỬA SẢN PHẨM: @Model.Name
                </h3>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                <div class="card-body">
                    <div class="form-group">
                        <label>Tên <span class="text-danger">*</span></label>
                        <input class="form-control @(fieldErrors.ContainsKey("name") ? "is-invalid" : "")" id="name" name="name" type="text" value="@Model.Name" onchange="getSlug()">
                        @if (fieldErrors.ContainsKey("name"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["name"]</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Slug <span class="text-danger">*</span></label>
                        <input class="form-control @(fieldErrors.ContainsKey("slug") ? "is-invalid" : "")" id="slug" name="slug" type="text" value="@Model.Slug">
                        @if (fieldErrors.ContainsKey("slug"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["slug"]</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Mô tả <span class="text-danger">*</span></label>
                        <textarea class="form-control @(fieldErrors.ContainsKey("description") ? "is-invalid" : "")" id="description" name="description" rows="3">@Model.Description</textarea>
                        @if (fieldErrors.ContainsKey("description"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["description"]</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Giá <span class="text-danger">*</span></label>
                        <input class="form-control @(fieldErrors.ContainsKey("price") ? "is-invalid" : "")" id="price" name="price" type="number" step="any" min="1000" value="@priceVal">
                        @if (fieldErrors.ContainsKey("price"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["price"]</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Hình ảnh</label>
                        <input class="form-control" id="image" name="image" type="text" value="@Model.Image">
                        <div class="input-group form-group">
                            <input type="file" name="fileUpload" id="fileUpload" accept="image/*"
                                   style="display:none;" />
                            <span class="input-group-btn">
                                <input type="button" id="btnUpload" value="Chọn" class="btn btn-success" />
                            </span>
                        </div>
                        <img src="@Model.Image" id="pictureUpload" class="img-fluid" />
                    </div>
                    <div class="form-group">
                        <label>Danh mục <span class="text-danger">*</span></label>
                        <select class="form-control @(fieldErrors.ContainsKey("category_id") ? "is-invalid" : "")" name="category_id">
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    bool isSelected = Model.Category != null && Model.Category.Id == category.Id;
                                    <option value="@category.Id" @(isSelected ? "selected" : "")>@category.Name</option>
                                }
                            }
                        </select>
                        @if (fieldErrors.ContainsKey("category_id"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["category_id"]</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Trạng thái</label>
                        <input type="checkbox" name="status" id="status" value="1" @(isActive ? "checked" : "")>
                        <label class="form-check-label" for="status">ON</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a href="@Url.Action("Index", "ManageProduct")" class="btn btn-secondary ml-2">Quay lại</a>
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
    function removeDiacritics(str) {
        str = str.replace(/Đ/g, "D");
        str = str.replace(/đ/g, "d");
        str = str.replace(/ /g, "-"); // replace space to "-"
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }
    function getSlug() {
        var name = $('#name').val();
        var result = removeDiacritics(name);
        $('#slug').val(result.toLowerCase());
    }
</script>

<script>
    $(function () {
        $('#btnUpload').click(function () {
            $('#fileUpload').trigger('click');
        });
    });
    $('#fileUpload').change(function () {
        if (window.FormData !== undefined) {
            var fileUpload = $('#fileUpload').get(0);
            var files = fileUpload.files;
            var formData = new FormData();
            formData.append('file', files[0]);

            $.ajax(
                {
                    type: 'POST',
                    url: '/Image/ProcessUpload',
                    contentType: false,
                    processData: false,
                    data: formData,
                    success: function (urlImage) {

                        $('#pictureUpload').attr('src', urlImage);
                        $('#image').val(urlImage);
                    },
                    error: function (err) {
                        alert('Error ', err.statusText);
                    }
                });
        }
    });
</script>
