@model LalaCoffee.Models.PropertyProduct

@{
    ViewBag.Title = "Chỉnh sửa kích cỡ sản phẩm";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    bool isActive = Model.Status == "1" 
        || string.Equals(Model.Status, "Show", StringComparison.OrdinalIgnoreCase) 
        || string.Equals(Model.Status, "Active", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Status, "True", StringComparison.OrdinalIgnoreCase);
}
@{
    var fieldErrors = (ViewBag.FieldErrors ?? TempData["FieldErrors"]) as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    string priceVal = ViewBag.PriceInput != null ? (string)ViewBag.PriceInput : Model.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
}
@Html.Partial("ErrorsAlert")

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Chỉnh sửa Kích cỡ</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb admin-breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/ManageOrder" class="text-decoration-none text-muted">Quản trị</a></li>
                <li class="breadcrumb-item"><a href="/Admin/ManagePropertyProduct" class="text-decoration-none text-muted">Kích cỡ</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Index", "ManagePropertyProduct")" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fas fa-arrow-left"></i>
        <span>Quay lại danh sách</span>
    </a>
</div>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0">
                    <i class="fas fa-edit me-2"></i> Thuộc tính: <strong>@Model.Name</strong>
                </h5>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="name">Tên kích cỡ / Thuộc tính <span class="text-danger">*</span></label>
                        <input class="form-control @(fieldErrors.ContainsKey("name") ? "is-invalid" : "")" id="name" name="name" type="text" value="@Model.Name">
                        @if (fieldErrors.ContainsKey("name"))
                        {
                            <span class="invalid-feedback d-block">@fieldErrors["name"]</span>
                        }
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="price">Phụ thu thêm (VNĐ) <span class="text-danger">*</span></label>
                            <input class="form-control @(fieldErrors.ContainsKey("price") ? "is-invalid" : "")" id="price" name="price" type="number" min="0" step="1000" value="@priceVal">
                            @if (fieldErrors.ContainsKey("price"))
                            {
                                <span class="invalid-feedback d-block">@fieldErrors["price"]</span>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="product_id">Sản phẩm áp dụng <span class="text-danger">*</span></label>
                            <select class="form-select @(fieldErrors.ContainsKey("product_id") ? "is-invalid" : "")" name="product_id" id="product_id">
                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Id" @(Model.Product != null && Model.Product.Id == product.Id ? "selected" : "")>@product.Name</option>
                                }
                            </select>
                            @if (fieldErrors.ContainsKey("product_id"))
                            {
                                <span class="invalid-feedback d-block">@fieldErrors["product_id"]</span>
                            }
                        </div>
                    </div>
                    <div class="form-check form-switch mt-3 mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" name="status" id="status" value="1" @(isActive ? "checked" : "")>
                        <label class="form-check-label fw-semibold" for="status">Cho phép khách chọn kích cỡ này</label>
                    </div>
                </div>
                <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("Index", "ManagePropertyProduct")" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            }
        </div>
    </div>
</div>
