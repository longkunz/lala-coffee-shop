@model LalaCoffee.Models.AdminResetPasswordViewModel
@{
    ViewBag.Title = "Đặt lại mật khẩu người dùng";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

<div class="admin-page-header d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Đặt lại mật khẩu người dùng</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Admin/ManageUser">Người dùng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đặt lại mật khẩu: @Model.UserName</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/Admin/ManageUser" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="fas fa-user-lock text-warning me-2"></i>Đổi mật khẩu cho: <span class="text-primary">@Model.UserName</span>
                </h5>
            </div>

            @using (Html.BeginForm("ResetPassword", "ManageUser", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UserId)
                @Html.HiddenFor(m => m.UserName)

                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> <strong>Lỗi đặt lại mật khẩu:</strong>
                            <div class="mt-2 ps-3">
                                @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0" })
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tài khoản</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fas fa-user"></i></span>
                            <input type="text" class="form-control bg-light" value="@Model.UserName" readonly disabled />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="NewPassword" class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-key"></i></span>
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Nhập mật khẩu mới cho người dùng", required = "required", id = "NewPassword" })
                            <button class="btn btn-outline-secondary btn-toggle-pw" type="button" data-target="NewPassword">
                                <i class="fas fa-eye-slash"></i>
                            </button>
                        </div>
                        <div class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i> Tối thiểu 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                        </div>
                        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Xác nhận lại mật khẩu mới", required = "required", id = "ConfirmPassword" })
                            <button class="btn btn-outline-secondary btn-toggle-pw" type="button" data-target="ConfirmPassword">
                                <i class="fas fa-eye-slash"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="card-footer bg-light border-top py-3 d-flex justify-content-between align-items-center">
                    <a href="/Admin/ManageUser" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning fw-semibold px-4">
                        <i class="fas fa-save me-1"></i> Lưu mật khẩu mới
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('.btn-toggle-pw').on('click', function (e) {
                e.preventDefault();
                var targetId = $(this).data('target');
                var $input = $('#' + targetId);
                var $icon = $(this).find('i');
                if ($input.attr('type') === 'password') {
                    $input.attr('type', 'text');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                } else {
                    $input.attr('type', 'password');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                }
            });
        });
    </script>
}
