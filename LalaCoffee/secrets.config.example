<appSettings>
  <!-- Email Settings -->
  <add key="Email_Sender" value="your-email@gmail.com" />
  <add key="Email_Password" value="your-gmail-app-password" />
  <add key="Email_Host" value="smtp.gmail.com" />
  <add key="Email_Port" value="587" />
  <add key="Email_EnableSsl" value="true" />
  <add key="Email_DisplayName" value="LalaCoffee" />
  <add key="Email_BaseUrl" value="https://lalacoffee.vn" />

  <!-- Momo Settings -->
  <add key="partnerCode_Momo" value="MOMOOJOI20210710" />
  <add key="accessKey_Momo" value="YOUR_MOMO_ACCESS_KEY" />
  <add key="secretKey_Momo" value="YOUR_MOMO_SECRET_KEY" />
  <add key="endPoint_Momo" value="https://test-payment.momo.vn/v2/gateway/api/create" />
  <add key="redirectUrl_Momo" value="https://lalacoffee.vn/Pay/MomoProcessing" />
  <add key="ipnUrl_Momo" value="https://lalacoffee.vn/Pay/MomoIpn" />

  <!-- VNPay Settings -->
  <add key="vnp_HashSecret" value="YOUR_VNPAY_HASH_SECRET" />
  <add key="vnp_TmnCode" value="ZAQBCKU5" />
  <add key="vnp_Url" value="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html" />
  <add key="vnp_ReturnUrl" value="https://lalacoffee.vn/Pay/VNPayProcessing" />
</appSettings>
